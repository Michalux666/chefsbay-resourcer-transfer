# Resourcer profile settings: a TEMPLATE. It holds placeholders and defaults only, never real values.
#
# HOW TO USE
#   - Do NOT copy this file over the live .env. A shell write to .env* needs approval and the file tools cannot write it.
#   - The OWNER adds each key on the Hermes dashboard, API Keys page, with the profile switcher set to "resourcer"
#     (add a custom key when the name is not listed). Values marked HUMAN-ONLY are typed there, never in chat, never by the operator.
#   - Non-secret tuning lines may be set by the operator only when the owner asks for that exact setting.
#   - An empty value means "unset". A line starting with # is a comment. Quotes are optional.
#   - Live file: /opt/data/profiles/resourcer/.env (mode 0600). Check that a key exists without printing it:
#         grep -c '^AI_GATEWAY_API_KEY=.' /opt/data/profiles/resourcer/.env      (prints 1 or 0)
#   - Precedence: real process environment, then RESOURCER_ENV_FILE, then this profile .env, then RESOURCER_HOME/.env.
#   - Full reference with defaults and meanings: docs/ENV.md.
#
# NOT settable here (read from the process environment or set by the cron wrappers): RESOURCER_HOME, HERMES_HOME, RESOURCER_ENV_FILE,
# RESOURCER_TEST_NOW, BUNDLE_* (tools/ read the environment only). Credential FILES do not go here either: secrets/caterer-credentials.json,
# secrets/zoho-credentials.json and secrets/reed-credentials.json come from the data bundle (docs/INSTALL.md) and are rotated by the owner.

# ===== REQUIRED =====

# HUMAN-ONLY secret. Vercel AI Gateway key. It is used for Jev (typesafe-ai/jev) ONLY: the owner's Vercel team allows no other model through the gateway.
# Without it (or if Jev is refused) screening is unavailable and the pipeline halts.
AI_GATEWAY_API_KEY=

# HUMAN-ONLY secret. Passphrase (16 characters or more) for the nightly encrypted database backup. Alternative: a file secrets/backup-passphrase (mode 0600).
# Keep a copy OFF the instance (a password manager): backups cannot be read without it if the instance is lost.
BACKUP_PASSPHRASE=

# HUMAN-ONLY, INSTALL TIME ONLY. Bundle passphrase (16 characters or more), route 2 of docs/INSTALL.md section 5.1: the owner types it here, the operator moves it into a
# 0600 file (secrets/bundle-passphrase) without displaying it, and the owner DELETES this key after the restore. Route 1 (the owner creates the file in their own terminal) is preferred.
# BUNDLE_PASSPHRASE=

# ===== SOURCES =====

# caterer | reed | both. Reed stays off until the Reed canary has passed (docs/DECISIONS.md OD-E). Then set both.
# RESOURCER_SOURCES=caterer

# ===== SCREENING (docs/SCREENING.md) =====

# jev_only | llm | jev_shadow | jev. jev_only (the default) = Jev is the ONLY model; no request ever goes to a language model. NEVER set another engine here:
# llm, jev_shadow and jev call the gateway's chat endpoint, which the owner's Vercel team blocks (HTTP 403). Other models come later through the Hermes runtime.
# The code refuses them anyway: without SCREEN_ALLOW_LLM=1 any other value becomes jev_only (with a warning), so an old leftover line is harmless.
# SCREEN_ENGINE=jev_only
# NEVER set this. 1 would let the language-model engines run, and the Vercel team blocks their models.
# SCREEN_ALLOW_LLM=
# jev_only: what a card Jev is not sure about becomes. Before the unlock: reject (default, the old fail-closed rule) or approve (recall-tilted: costs an unlock credit).
# After the unlock: approve (default) or reject. Owner decisions (docs/SCREENING.md section 16.3).
# SCREEN_REVIEW_PRE=reject
# SCREEN_REVIEW_POST=approve
# legacy | fixed. fixed makes "Commis Chef" tier 1 (changes who is rejected). Owner decision.
# SCREEN_TIER_MODE=legacy
# Marks the Jev thresholds as calibrated. In jev_only it only silences the one-line "uncalibrated placeholder thresholds" warning printed once per run.
# SCREEN_CALIBRATED=
# SCREEN_LLM_MODEL, SCREEN_LLM_BACKUP_MODEL, SCREEN_LLM_ZDR, SCREEN_LLM_CONCURRENCY and SCREEN_LLM_TIMEOUT_MS are UNUSED in jev_only (they belong to the
# language-model engines, which the Vercel team blocks). Leave them unset.
# SCREEN_LLM_MODEL=anthropic/claude-sonnet-5.5
# SCREEN_LLM_BACKUP_MODEL=anthropic/claude-sonnet-5
# Jev model slug. In jev_only a name without "jev" in it is replaced by this default.
# SCREEN_JEV_MODEL=typesafe-ai/jev
# Ask the gateway for zero data retention. Turn on ONLY after the install canary proves it works for Jev (otherwise screening fails with HTTP 400 and the pipeline halts).
# In jev_only SCREEN_JEV_ZDR and SCREEN_ZDR mean the same; SCREEN_LLM_ZDR is unused.
# SCREEN_ZDR=
# SCREEN_LLM_ZDR=
# SCREEN_JEV_ZDR=
# Shadow log of every decision (redacted card text, 180 days). 0 or off switches the text or the whole log off.
# SCREEN_SHADOW=on
# SCREEN_SHADOW_TEXT=on
# SCREEN_SHADOW_RATE=1
# Leave redaction on.
# SCREEN_REDACT=on
# Opt-in rubric variants of the language-model prompt (owner decisions; UNUSED in jev_only, where SCREEN_REVIEW_PRE is the recall switch): profile-out-of-date clause; recall-tilted borderline policy (legacy | lenient).
# SCREEN_STALE_RULE=off
# SCREEN_INSUFFICIENT=legacy
# Throughput and timing (defaults are tested; change only on evidence).
# SCREEN_CONCURRENCY=6
# SCREEN_LLM_CONCURRENCY=4
# SCREEN_JEV_TIMEOUT_MS=15000
# SCREEN_LLM_TIMEOUT_MS=60000
# SCREEN_MAX_ATTEMPTS=3
# SCREEN_CACHE_TTL_SEC=3600
# SCREEN_PAGE_RETRY_PAUSE_SEC=120
# Gateway origin: leave the default. Anything else receives the key and the redacted candidate text.
# SCREEN_GATEWAY_ORIGIN=https://ai-gateway.vercel.sh
# SCREEN_CONFIG_FILE=

# ===== BACKUPS AND ALERTS =====

# Off-instance copy of each encrypted backup: a JSON array; {file} {name} {manifest} are replaced. The owner chooses the target (an object store, a mailbox, a drive).
# BACKUP_UPLOAD_CMD=["rclone","copyto","{file}","remote:resourcer-backups/{name}"]
# Names of settings passed to that command (for example its access key, which must also be a line in this file). Nothing else secret is passed.
# BACKUP_UPLOAD_ENV=
# HUMAN-ONLY secret. A ping URL called once a day after 06:00 London by the alert job; a missing ping tells an external service the instance is down.
# RESOURCER_DEADMAN_URL=

# ===== BROWSER =====

# Only when Chromium is not at /usr/bin/chromium, /usr/bin/chromium-browser or the path the Hermes image records.
# CHROMIUM_PATH=
# Browser locale (off disables). A UK address with a UTC browser is a bot signal.
# RESOURCER_BROWSER_TZ=Europe/London
# RESOURCER_BROWSER_LANG=en-GB
# Comma-separated Chromium flags (replace the defaults).
# RESOURCER_AB_CHROME_ARGS=--no-sandbox,--disable-dev-shm-usage,--lang=en-GB
# REED_CHROME_ARGS=--no-sandbox,--disable-dev-shm-usage,--lang=en-GB
# Location of the pinned agent-browser 0.21.0 (default <profile>/bin/agent-browser).
# RESOURCER_AB_BIN=
# Headed fallback for the Caterer browser if headless is blocked (needs a persistent display). Owner decision.
# RESOURCER_AB_HEADED=
# RESOURCER_AB_DISPLAY=
# Cache mode of unlock and CV downloads through the Caterer browser. Leave at no-store.
# RESOURCER_FETCH_CACHE=no-store
# Minutes between Caterer login attempts after a safe-list block.
# CATERER_SAFELIST_COOLDOWN_MIN=60
# Override of the saved Caterer session file (must agree everywhere; leave unset).
# CATERER_SESSION_FILE=

# ===== REED (only once Reed is enabled) =====

# REED_CDP_PORT=9222
# REED_CHROME_PROFILE=
# REED_TARGET_URL=
# REED_LOGIN_URL=
# REED_KEEP_CHROME=0
# REED_LOCK_WAIT_SEC=300
# REED_LOGIN_BLOCK_HOURS=12
# REED_AUTH_HOLD_MIN=30
# REED_ALERT_REMIND_HOURS=72
# REED_AUTO_RELAUNCH=1
# REED_REFRESH_TIMEOUT_MS=90000
# REED_LOGIN_TIMEOUT_MS=90000
# REED_LAUNCH_TIMEOUT_MS=60000
# REED_CAPTURE_TIMEOUT_MS=45000
# REED_SCREEN_TIMEOUT_MS=900000

# ===== SUPERVISION =====

# Length of one supervision tick in minutes. 55 is the maximum; lower only.
# RESOURCER_MAX_TICK_MIN=55
# Pause after the session check, and the wait for the shared browser lock (milliseconds).
# RESOURCER_SETTLE_MS=5000
# RESOURCER_BROWSER_LOCK_WAIT_MS=30000

# ===== PHASE 1 LIMITS (defaults are the tested values) =====

# PHASE1_MAX_CONSECUTIVE_PAGE_ERRORS=5
# PHASE1_INCOMPLETE_MAX_RUNS=3
# PHASE1_UNLOCK_FAIL_LIMIT=5
# PHASE1_DB_FAIL_LIMIT=3
# PHASE1_HEARTBEAT_SEC=20
# PHASE1_SETTLE_MS=5000
# PHASE1_UNLOCK_PAUSE_MS=1500
# PHASE1_LOCK_TIMEOUT_SEC=30
# PHASE1_CREDITS_TIMEOUT_SEC=180
# PHASE1_DB_TIMEOUT_SEC=60
# PHASE1_SCREEN_TIMEOUT_SEC=1500
# PHASE1_SINGLE_TIMEOUT_SEC=330
# PHASE1_UNLOCK_TIMEOUT_SEC=180
# PHASE1_HANDOFF_TIMEOUT_SEC=3900
# PHASE1_LOGIN_TIMEOUT_SEC=600

# ===== NEVER SET IN A PROFILE (tests only) =====
# RESOURCER_TEST_NOW, PHASE1_SCRIPT_<NAME>, REED_CDP_TRUST_EXISTING, RESOURCER_SLEEP_SCALE, RESOURCER_AB_NAV_GAP_MS, RESOURCER_AB_IPC_READ_MS, REED_API_BASE, REED_XVFB_RUN, SCREEN_INPUT_MODE,
# SCREEN_BACKOFF_BASE_MS, SCREEN_RETRY_AFTER_CAP_MS, SCREEN_SOURCE, SCREEN_RUN_ID, PHASE1_RUN_TIMESTAMP, the E2E_*, FAKE_*, P1_* families.
