{
  "_comment": "Shared by tests/dashboard/py/test_plugin_api.py and tests/dashboard/request-search.test.js: both implementations must produce identical output. Synthetic data only.",
  "defaults": { "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "priority": "low", "sources": "both" },
  "cases": [
    { "name": "minimal", "input": { "jobTitle": "sous chef", "location": "yo2" },
      "ok": { "jobTitle": "Sous Chef", "location": "YO2", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "acronym kept upper case", "input": { "jobTitle": "kitchen assistant dbs", "location": "m1" },
      "ok": { "jobTitle": "Kitchen Assistant DBS", "location": "M1", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "whitespace collapsed", "input": { "jobTitle": "  Head   Chef ", "location": " ls1 " },
      "ok": { "jobTitle": "Head Chef", "location": "LS1", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "tab and newline are whitespace", "input": { "jobTitle": "Sous\tChef\n", "location": "NE1" },
      "ok": { "jobTitle": "Sous Chef", "location": "NE1", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "every field, string numbers", "input": { "jobTitle": "Chef de Partie", "location": "EC1A", "keywords": "DBS food hygiene, DBS", "sources": "caterer", "priority": "high", "distance": "30", "activeWithin": "3 months", "cvLimit": "40" },
      "ok": { "jobTitle": "Chef De Partie", "location": "EC1A", "keywords": "dbs food hygiene", "priority": "high", "sources": "caterer", "distance": 30, "activeWithin": "3 months", "cvLimit": 40, "overrides": ["distance", "activeWithin", "cvLimit"] } },
    { "name": "distance override only", "input": { "jobTitle": "Chef", "location": "W1A", "distance": 30 },
      "ok": { "jobTitle": "Chef", "location": "W1A", "keywords": "", "priority": "low", "sources": "both", "distance": 30, "activeWithin": "1 month", "cvLimit": 20, "overrides": ["distance"] } },
    { "name": "null optional fields use defaults", "input": { "jobTitle": "Chef", "location": "B1", "keywords": null, "sources": null, "priority": null, "distance": null, "activeWithin": null, "cvLimit": null },
      "ok": { "jobTitle": "Chef", "location": "B1", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "keyword sentinel none", "input": { "jobTitle": "Chef", "location": "B1", "keywords": "None" },
      "ok": { "jobTitle": "Chef", "location": "B1", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "keyword sentinel n/a", "input": { "jobTitle": "Chef", "location": "B1", "keywords": " n/a " },
      "ok": { "jobTitle": "Chef", "location": "B1", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "keyword location tokens dropped", "input": { "jobTitle": "Chef", "location": "B1", "keywords": "location:leeds currentlocation:york halal" },
      "ok": { "jobTitle": "Chef", "location": "B1", "keywords": "halal", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "keywords deduplicated and sorted", "input": { "jobTitle": "Chef", "location": "B1", "keywords": "Vegan, halal Halal" },
      "ok": { "jobTitle": "Chef", "location": "B1", "keywords": "halal vegan", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "title with allowed punctuation", "input": { "jobTitle": "F&B Supervisor (nights)", "location": "M1" },
      "ok": { "jobTitle": "F&b Supervisor (nights)", "location": "M1", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "custom defaults respected", "defaults": { "distance": 30, "activeWithin": "2 months", "cvLimit": 30, "priority": "medium", "sources": "caterer" }, "input": { "jobTitle": "Chef", "location": "M1", "distance": 20 },
      "ok": { "jobTitle": "Chef", "location": "M1", "keywords": "", "priority": "medium", "sources": "caterer", "distance": 20, "activeWithin": "2 months", "cvLimit": 30, "overrides": ["distance"] } },

    { "name": "missing title", "input": { "location": "M1" }, "error": "jobTitle" },
    { "name": "blank title", "input": { "jobTitle": "   ", "location": "M1" }, "error": "jobTitle" },
    { "name": "numeric title", "input": { "jobTitle": 123, "location": "M1" }, "error": "jobTitle" },
    { "name": "html in title", "input": { "jobTitle": "<script>alert(1)</script>", "location": "M1" }, "error": "jobTitle" },
    { "name": "one character title", "input": { "jobTitle": "x", "location": "M1" }, "error": "jobTitle" },
    { "name": "title too long", "input": { "jobTitle": "Chef Chef Chef Chef Chef Chef Chef Chef Chef Chef Chef Chef Chef", "location": "M1" }, "error": "jobTitle" },
    { "name": "title with non-ascii", "input": { "jobTitle": "Sommelier Café", "location": "M1" }, "error": "jobTitle" },
    { "name": "missing location", "input": { "jobTitle": "Chef" }, "error": "location" },
    { "name": "city name rejected", "input": { "jobTitle": "Chef", "location": "York" }, "error": "location" },
    { "name": "city name rejected in any mode", "mode": "any", "input": { "jobTitle": "Chef", "location": "Leeds" }, "error": "location" },
    { "name": "full postcode rejected in outward mode", "input": { "jobTitle": "Chef", "location": "LS1 4AB" }, "error": "location" },
    { "name": "digits only location", "input": { "jobTitle": "Chef", "location": "12345" }, "error": "location" },
    { "name": "html in location", "input": { "jobTitle": "Chef", "location": "<b>" }, "error": "location" },
    { "name": "place rejected in outward mode", "input": { "jobTitle": "Chef", "location": "Harrogate" }, "error": "location" },
    { "name": "place accepted in any mode", "mode": "any", "input": { "jobTitle": "Chef", "location": "harrogate" },
      "ok": { "jobTitle": "Chef", "location": "HARROGATE", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "full postcode accepted in any mode", "mode": "any", "input": { "jobTitle": "Chef", "location": "ls1 4ab" },
      "ok": { "jobTitle": "Chef", "location": "LS1 4AB", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "full postcode without space in any mode", "mode": "any", "input": { "jobTitle": "Chef", "location": "yo241ab" },
      "ok": { "jobTitle": "Chef", "location": "YO24 1AB", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "outward code still fine in any mode", "mode": "any", "input": { "jobTitle": "Chef", "location": "M1" },
      "ok": { "jobTitle": "Chef", "location": "M1", "keywords": "", "priority": "low", "sources": "both", "distance": 20, "activeWithin": "1 month", "cvLimit": 20, "overrides": [] } },
    { "name": "keywords with html", "input": { "jobTitle": "Chef", "location": "M1", "keywords": "<b>x</b>" }, "error": "keywords" },
    { "name": "keywords too long raw", "input": { "jobTitle": "Chef", "location": "M1", "keywords": "aaaaaaaaaa aaaaaaaaaa aaaaaaaaaa aaaaaaaaaa aaaaaaaaaa aaaaaaaaaa aaaaaaaaaa aaaaaaaaaa aaaaaaaaaa aaaaaaaaaa aaaaaaaaaa aaaaaaaaaa" }, "error": "keywords" },
    { "name": "keywords too long once normalised", "input": { "jobTitle": "Chef", "location": "M1", "keywords": "aaaaaaaa bbbbbbbb cccccccc dddddddd eeeeeeee ffffffff gggggggg hhhhhhhh" }, "error": "keywords" },
    { "name": "keywords not a string", "input": { "jobTitle": "Chef", "location": "M1", "keywords": 5 }, "error": "keywords" },
    { "name": "unknown source", "input": { "jobTitle": "Chef", "location": "M1", "sources": "all" }, "error": "sources" },
    { "name": "empty source", "input": { "jobTitle": "Chef", "location": "M1", "sources": "" }, "error": "sources" },
    { "name": "unknown priority", "input": { "jobTitle": "Chef", "location": "M1", "priority": "urgent" }, "error": "priority" },
    { "name": "distance 15 not offered", "input": { "jobTitle": "Chef", "location": "M1", "distance": 15 }, "error": "distance" },
    { "name": "distance 50 not offered", "input": { "jobTitle": "Chef", "location": "M1", "distance": 50 }, "error": "distance" },
    { "name": "distance zero", "input": { "jobTitle": "Chef", "location": "M1", "distance": 0 }, "error": "distance" },
    { "name": "distance text", "input": { "jobTitle": "Chef", "location": "M1", "distance": "abc" }, "error": "distance" },
    { "name": "distance boolean", "input": { "jobTitle": "Chef", "location": "M1", "distance": true }, "error": "distance" },
    { "name": "distance fractional", "input": { "jobTitle": "Chef", "location": "M1", "distance": 20.5 }, "error": "distance" },
    { "name": "activeWithin unknown", "input": { "jobTitle": "Chef", "location": "M1", "activeWithin": "2 weeks" }, "error": "activeWithin" },
    { "name": "activeWithin not a string", "input": { "jobTitle": "Chef", "location": "M1", "activeWithin": 5 }, "error": "activeWithin" },
    { "name": "cvLimit too low", "input": { "jobTitle": "Chef", "location": "M1", "cvLimit": 5 }, "error": "cvLimit" },
    { "name": "cvLimit too high", "input": { "jobTitle": "Chef", "location": "M1", "cvLimit": 51 }, "error": "cvLimit" },
    { "name": "cvLimit text", "input": { "jobTitle": "Chef", "location": "M1", "cvLimit": "abc" }, "error": "cvLimit" },
    { "name": "cvLimit boolean", "input": { "jobTitle": "Chef", "location": "M1", "cvLimit": true }, "error": "cvLimit" }
  ]
}
